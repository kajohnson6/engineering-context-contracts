{
  "$defs": {
    "ApplicabilityDecision": {
      "enum": [
        "applicable",
        "not_applicable",
        "requires_review"
      ],
      "title": "ApplicabilityDecision",
      "type": "string"
    },
    "ApplicabilityEnvelope": {
      "additionalProperties": false,
      "properties": {
        "access_policy_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Access Policy Sha256"
        },
        "agent_profiles": {
          "items": {
            "type": "string"
          },
          "title": "Agent Profiles",
          "type": "array"
        },
        "architectures": {
          "items": {
            "type": "string"
          },
          "title": "Architectures",
          "type": "array"
        },
        "configuration_selectors": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Configuration Selectors",
          "type": "object"
        },
        "consumer_models": {
          "items": {
            "type": "string"
          },
          "title": "Consumer Models",
          "type": "array"
        },
        "corpus_revision": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Revision"
        },
        "corpus_snapshot_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Corpus Snapshot Sha256"
        },
        "device_families": {
          "items": {
            "type": "string"
          },
          "title": "Device Families",
          "type": "array"
        },
        "document_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "document_revision": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Revision"
        },
        "exact_devices": {
          "items": {
            "type": "string"
          },
          "title": "Exact Devices",
          "type": "array"
        },
        "policy_domain": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Domain"
        },
        "project_configuration_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Project Configuration Sha256"
        },
        "repository_commit": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Commit"
        },
        "repository_revision": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Revision"
        },
        "repository_revision_max": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Revision Max"
        },
        "repository_revision_min": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Revision Min"
        },
        "repository_tag": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Tag"
        },
        "repository_uri": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository Uri"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "silicon_steppings": {
          "items": {
            "type": "string"
          },
          "title": "Silicon Steppings",
          "type": "array"
        },
        "tool_identity": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Identity"
        },
        "tool_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version"
        },
        "tool_version_max_exclusive": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version Max Exclusive"
        },
        "tool_version_min_inclusive": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Version Min Inclusive"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        }
      },
      "title": "ApplicabilityEnvelope",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "description": "Provider-neutral locator plus content identity.\n\n``uri`` may move or expire.  ``sha256`` is the artifact identity.",
      "properties": {
        "artifact_schema_version": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Schema Version"
        },
        "artifact_type": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Artifact Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "uri": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        }
      },
      "required": [
        "artifact_type",
        "uri",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CacheDisposition": {
      "enum": [
        "hit",
        "miss",
        "bypass",
        "negative_hit"
      ],
      "title": "CacheDisposition",
      "type": "string"
    },
    "CacheLayer": {
      "enum": [
        "exact_query",
        "structured_obligation",
        "hot_evidence"
      ],
      "title": "CacheLayer",
      "type": "string"
    },
    "CacheReceipt": {
      "additionalProperties": false,
      "properties": {
        "applicability_check_performed": {
          "title": "Applicability Check Performed",
          "type": "boolean"
        },
        "cache_layer": {
          "$ref": "#/$defs/CacheLayer"
        },
        "canonical_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Canonical Key Sha256",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/CacheDisposition"
        },
        "key_components": {
          "additionalProperties": true,
          "title": "Key Components",
          "type": "object"
        },
        "lifecycle_check_performed": {
          "title": "Lifecycle Check Performed",
          "type": "boolean"
        },
        "negative_failure_class": {
          "anyOf": [
            {
              "const": "semantic_unsatisfied",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Negative Failure Class"
        },
        "policy_check_performed": {
          "title": "Policy Check Performed",
          "type": "boolean"
        },
        "producer_version": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Producer Version",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "reused_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Reused Artifacts",
          "type": "array"
        },
        "review_after": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review After"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unsatisfied_obligations": {
          "items": {
            "type": "string"
          },
          "title": "Unsatisfied Obligations",
          "type": "array"
        }
      },
      "required": [
        "cache_layer",
        "canonical_key_sha256",
        "key_components",
        "disposition",
        "lifecycle_check_performed",
        "applicability_check_performed",
        "policy_check_performed",
        "producer_version"
      ],
      "title": "CacheReceipt",
      "type": "object"
    },
    "ConsiderationDisposition": {
      "additionalProperties": false,
      "properties": {
        "citation_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consideration_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Consideration Id",
          "type": "string"
        },
        "delivery_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Delivery Receipt Sha256",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/DispositionStatus"
        },
        "disposition_id": {
          "format": "uuid",
          "title": "Disposition Id",
          "type": "string"
        },
        "explanation": {
          "default": "",
          "maxLength": 4000,
          "title": "Explanation",
          "type": "string"
        },
        "implementation_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome_reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/FeedbackReasonCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "delivery_receipt_sha256",
        "consideration_id",
        "disposition"
      ],
      "title": "ConsiderationDisposition",
      "type": "object"
    },
    "CorrectnessAssessment": {
      "enum": [
        "correct",
        "incorrect",
        "contradicted",
        "requires_review",
        "not_assessed"
      ],
      "title": "CorrectnessAssessment",
      "type": "string"
    },
    "DispositionStatus": {
      "enum": [
        "applied",
        "rejected",
        "not_applicable"
      ],
      "title": "DispositionStatus",
      "type": "string"
    },
    "EligibilityExplanation": {
      "additionalProperties": false,
      "properties": {
        "applicability_constraint": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "applicability_result": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "eligible": {
          "title": "Eligible",
          "type": "boolean"
        },
        "lifecycle_event_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lifecycle Event Sha256"
        },
        "lifecycle_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleState"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "request_context": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "required_considerations": {
          "items": {
            "$ref": "#/$defs/RequiredConsideration"
          },
          "title": "Required Considerations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "target",
        "lifecycle_state",
        "applicability_result",
        "eligible"
      ],
      "title": "EligibilityExplanation",
      "type": "object"
    },
    "EvidenceDeliveryReceipt": {
      "additionalProperties": false,
      "properties": {
        "admission_receipt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "applicability_result": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "cache_receipt": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "consumer_identity": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Consumer Identity",
          "type": "string"
        },
        "consumer_profile": {
          "anyOf": [
            {
              "maxLength": 300,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consumer Profile"
