          "maxLength": 100,
          "minLength": 1,
          "title": "Actor Class",
          "type": "string"
        },
        "actor_identity": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Actor Identity",
          "type": "string"
        },
        "applicability": {
          "$ref": "#/$defs/ApplicabilityDecision"
        },
        "correctness": {
          "$ref": "#/$defs/CorrectnessAssessment"
        },
        "delivery_disposition": {
          "anyOf": [
            {
              "$ref": "#/$defs/DispositionStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "explanation": {
          "default": "",
          "maxLength": 4000,
          "title": "Explanation",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "outcome_references": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Outcome References",
          "type": "array"
        },
        "reason_code": {
          "$ref": "#/$defs/FeedbackReasonCode"
        },
        "request_context": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "requested_lifecycle_transition": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supporting_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Supporting Artifacts",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "utility": {
          "$ref": "#/$defs/UtilityAssessment"
