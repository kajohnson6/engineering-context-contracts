        "resolved_at": {
          "format": "date-time",
          "title": "Resolved At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "request"
      ],
      "title": "EvidenceResolverReceipt",
      "type": "object"
