        "delivered_at": {
          "format": "date-time",
          "title": "Delivered At",
          "type": "string"
        },
        "evidence_applicability": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "packet": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "policy": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "request_context": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "required_considerations": {
          "items": {
            "$ref": "#/$defs/RequiredConsideration"
          },
          "title": "Required Considerations",
          "type": "array"
        },
        "resolver_receipt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "consumer_identity",
        "packet",
        "admission_receipt",
        "resolver_receipt",
        "policy",
        "applicability_result"
      ],
      "title": "EvidenceDeliveryReceipt",
      "type": "object"
    },
    "EvidenceOutcomeReceipt": {
      "additionalProperties": false,
      "properties": {
        "delivery_receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Delivery Receipt Sha256",
          "type": "string"
        },
        "disposition_references": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Disposition References",
          "type": "array"
        },
        "execution_environment": {
          "additionalProperties": true,
          "title": "Execution Environment",
          "type": "object"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/OutcomeMetric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "outcome": {
          "$ref": "#/$defs/OutcomeStatus"
        },
        "producer": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Producer",
          "type": "string"
        },
        "receipt_id": {
          "format": "uuid",
          "title": "Receipt Id",
          "type": "string"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "result_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Result Artifacts",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "version_pins": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Version Pins",
          "type": "object"
        }
      },
      "required": [
        "delivery_receipt_sha256",
        "outcome",
        "producer"
      ],
      "title": "EvidenceOutcomeReceipt",
      "type": "object"
    },
    "EvidenceResolverReceipt": {
      "additionalProperties": false,
      "properties": {
        "eligible": {
          "items": {
            "$ref": "#/$defs/EligibilityExplanation"
          },
          "title": "Eligible",
          "type": "array"
        },
        "excluded": {
          "items": {
            "$ref": "#/$defs/EligibilityExplanation"
          },
          "title": "Excluded",
          "type": "array"
        },
        "receipt_id": {
          "format": "uuid",
