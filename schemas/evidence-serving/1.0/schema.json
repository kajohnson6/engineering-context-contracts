      "enum": [
        "useful-applied",
        "useful-not-applicable",
        "irrelevant",
        "stale-version",
        "incorrect",
        "contradicted-by-experiment",
        "duplicate",
        "overly-broad",
        "unsafe",
        "license-incompatible"
      ],
      "title": "FeedbackReasonCode",
      "type": "string"
    },
    "LifecycleEvent": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Actor Class",
          "type": "string"
        },
        "actor_identity": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Actor Identity",
          "type": "string"
        },
        "applicability": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "event_id": {
          "format": "uuid",
          "title": "Event Id",
          "type": "string"
        },
        "next_state": {
          "$ref": "#/$defs/LifecycleState"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "predecessor_event_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predecessor Event Sha256"
        },
        "previous_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/LifecycleState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "purge_authorization": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reason_code": {
          "$ref": "#/$defs/LifecycleReasonCode"
        },
        "replacements": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Replacements",
          "type": "array"
        },
        "required_considerations": {
          "items": {
            "$ref": "#/$defs/RequiredConsideration"
          },
          "title": "Required Considerations",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supersedes": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Supersedes",
          "type": "array"
        },
        "supporting_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Supporting Artifacts",
          "type": "array"
        },
        "target": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "tombstone_metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tombstone Metadata",
          "type": "object"
        },
        "transition_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transition Id"
        }
      },
      "required": [
        "target",
        "next_state",
        "reason_code",
        "actor_class",
        "actor_identity"
      ],
      "title": "LifecycleEvent",
      "type": "object"
    },
    "LifecycleReasonCode": {
      "enum": [
        "initial-activation",
        "authoritative-revision",
        "policy-change",
        "manual-review",
        "secret-exposure",
        "legal-license-purge",
        "poisoned-content",
        "stale-version",
        "incorrect",
        "contradicted-by-experiment",
        "duplicate",
        "overly-broad",
        "unsafe",
        "license-incompatible"
      ],
      "title": "LifecycleReasonCode",
      "type": "string"
    },
    "LifecycleState": {
      "enum": [
        "active",
        "superseded",
        "deprecated",
        "retracted",
        "quarantined",
        "tombstoned"
      ],
      "title": "LifecycleState",
      "type": "string"
    },
    "MetricDirection": {
      "enum": [
        "lower_is_better",
        "higher_is_better",
        "neutral"
      ],
      "title": "MetricDirection",
      "type": "string"
    },
    "OutcomeMetric": {
      "additionalProperties": false,
      "properties": {
        "direction": {
          "$ref": "#/$defs/MetricDirection"
        },
        "name": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "name",
        "value",
        "unit",
        "direction"
      ],
      "title": "OutcomeMetric",
      "type": "object"
    },
    "OutcomeStatus": {
      "enum": [
        "pass",
        "fail",
        "review"
      ],
      "title": "OutcomeStatus",
      "type": "string"
    },
    "RequiredConsideration": {
      "additionalProperties": false,
      "properties": {
        "basis": {
          "enum": [
            "admitted_obligation",
            "verified_fact"
          ],
          "title": "Basis",
          "type": "string"
        },
        "consideration_id": {
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,199}$",
          "title": "Consideration Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "source_obligation_id": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Obligation Id"
        },
        "text": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "consideration_id",
        "text",
        "source",
        "basis"
      ],
      "title": "RequiredConsideration",
      "type": "object"
    },
    "ResolveEvidenceRequest": {
      "additionalProperties": false,
      "properties": {
        "candidate_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Candidate Artifacts",
          "type": "array"
        },
        "include_deprecated": {
          "default": false,
          "title": "Include Deprecated",
          "type": "boolean"
        },
        "request_context": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "requested_at": {
          "format": "date-time",
          "title": "Requested At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "task_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id"
      ],
      "title": "ResolveEvidenceRequest",
      "type": "object"
    },
    "SupersessionReceipt": {
      "additionalProperties": false,
      "properties": {
        "new_event": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "old_event": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "transition_id": {
          "format": "uuid",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "transition_id",
        "old_event",
        "new_event"
      ],
      "title": "SupersessionReceipt",
      "type": "object"
    },
    "SupersessionRequest": {
      "additionalProperties": false,
      "properties": {
        "actor_class": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Actor Class",
          "type": "string"
        },
        "actor_identity": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Actor Identity",
          "type": "string"
        },
        "new_applicability": {
          "$ref": "#/$defs/ApplicabilityEnvelope"
        },
        "new_event_id": {
          "format": "uuid",
          "title": "New Event Id",
          "type": "string"
        },
        "new_required_considerations": {
          "items": {
            "$ref": "#/$defs/RequiredConsideration"
          },
          "title": "New Required Considerations",
          "type": "array"
        },
        "new_target": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "old_event_id": {
          "format": "uuid",
          "title": "Old Event Id",
          "type": "string"
        },
        "old_predecessor_event_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Old Predecessor Event Sha256",
          "type": "string"
        },
        "old_target": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "reason_code": {
          "$ref": "#/$defs/LifecycleReasonCode",
          "default": "authoritative-revision"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "supporting_artifacts": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Supporting Artifacts",
          "type": "array"
        },
        "transition_id": {
          "format": "uuid",
          "title": "Transition Id",
          "type": "string"
        }
      },
      "required": [
        "old_target",
        "new_target",
        "old_predecessor_event_sha256",
        "actor_class",
        "actor_identity"
      ],
      "title": "SupersessionRequest",
      "type": "object"
    },
    "UtilityAssessment": {
      "enum": [
        "useful",
        "neutral",
        "not_useful",
        "not_assessed"
      ],
      "title": "UtilityAssessment",
      "type": "string"
    }
  },
  "$id": "https://engineering-memory.local/evidence-serving.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/ArtifactRef"
    },
    {
      "$ref": "#/$defs/ApplicabilityEnvelope"
    },
    {
      "$ref": "#/$defs/LifecycleEvent"
    },
    {
      "$ref": "#/$defs/FeedbackEvent"
    },
    {
      "$ref": "#/$defs/EvidenceDeliveryReceipt"
    },
    {
      "$ref": "#/$defs/ConsiderationDisposition"
    },
    {
      "$ref": "#/$defs/EvidenceOutcomeReceipt"
    },
    {
      "$ref": "#/$defs/CacheReceipt"
    },
    {
      "$ref": "#/$defs/EvidenceResolverReceipt"
    },
    {
      "$ref": "#/$defs/SupersessionRequest"
    },
    {
      "$ref": "#/$defs/SupersessionReceipt"
    }
  ],
  "title": "Engineering Evidence Serving Contracts"
}
